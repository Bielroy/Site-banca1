# =====================================================================
#  .env.example — LISTA das configurações do servidor (Vercel → Settings →
#  Environment Variables). Aqui ficam só os NOMES e para que servem.
#  NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.
#  (Para testar no computador, copie para ".env", que o GitHub ignora.)
#
#  [obrigatória]  sem ela o site não funciona
#  [opcional]     tem valor padrão ou liga um recurso extra
# =====================================================================

# ---------- Firebase (banco de dados) ----------
# [obrigatória] chave pública do app web do Firebase (vai no site; o "VITE_" faz o build incluir)
VITE_FIREBASE_API_KEY=
# [opcional] a mesma chave com outro nome, se a de cima não estiver disponível no servidor
FIREBASE_WEB_API_KEY=
# [obrigatória] conta de serviço do Firebase (Console → Configurações do projeto → Contas de serviço)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# a chave privada inteira, com as quebras de linha como \n
FIREBASE_PRIVATE_KEY=

# ---------- Endereço do site ----------
# [obrigatória para o PIX automático] endereço público com https, sem barra no fim
# (o PagBank usa para avisar o pagamento). Ex.: https://site-banca1.vercel.app
PUBLIC_BASE_URL=
# [opcional] outros endereços que podem chamar o servidor, separados por vírgula
# (o domínio próprio e o da Vercel já estão na lista em lib/http.js)
ALLOWED_ORIGIN=

# ---------- PagBank (PIX automático) ----------
# [opcional] token da conta PagBank. Também pode ser cadastrado na tela Plataforma.
# É usado para gerar o PIX e para conferir a assinatura dos avisos de pagamento.
PAGBANK_API_TOKEN=
# [opcional] "sandbox" para testes; vazio ou "production" para o real
PAGBANK_ENV=

# ---------- Inteligência artificial (Gemini) ----------
# [opcional] sem ela, o assistente e as sugestões de IA ficam desligados
GEMINI_API_KEY=
# [opcional] modelo; padrão gemini-flash-latest (com modelos reserva se ele sair do ar)
GEMINI_MODEL=
# [opcional] limites diários de uso da IA (padrões: 1500, 150, 300)
CHAT_LIMITE_DIA=
COPILOTO_LIMITE_DIA=
IA_PAINEL_LIMITE_DIA=

# ---------- Fotos dos produtos (ImgBB) ----------
# [opcional] chave do ImgBB (32 letras/números). Também pode ser cadastrada na tela Plataforma.
IMGBB_API_KEY=

# ---------- Avisos no celular da equipe (notificações) ----------
# [opcional] par de chaves VAPID. A pública precisa do "VITE_" para ir no site.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- Segurança e limites ----------
# [obrigatória] senha que a Vercel usa para rodar o processamento noturno (cron)
CRON_SECRET=
# [opcional] senha da página de diagnóstico do assistente
DIAGNOSTICO_SECRET=
# [opcional] máximo de links de entrada no painel por hora, somando todas as lojas (padrão 30).
# Aumente quando houver muitas lojas.
LOGIN_TETO_HORA=
# [opcional] máximo de pedidos por loja em pouco tempo, contra enxurrada (padrão 150)
CHECKOUT_TETO_LOJA=
# [opcional] WhatsApp reserva (com DDI e DDD, só números) para loja sem número cadastrado.
# Vazio = loja sem WhatsApp não recebe pedido (a equipe é avisada).
WHATSAPP_FALLBACK=
